{
  "manifest_version": 3,
  "name": "Aegis Visual Safety Guard - DOM Blur Extension",
  "version": "1.0.0",
  "description": "Real-time AI visual safety overlay & screen blur on targeted DOM elements.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}